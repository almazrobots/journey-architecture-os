{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/almazrobots/journey-architecture-os/main/schemas/change-log.schema.json",
  "title": "Change log row",
  "description": "One material change to a governed journey model (ontology: Change, prefix CHG). One CSV row is one JSON object keyed by column header; an empty cell means 'not yet known' and is omitted from the object, so 'required' means the cell must be filled. List-valued cells hold IDs separated by ';' with no spaces. Required: change_id and journey_id (identity and scope), changed_at, change and reason (what changed, when and why), approved_by (an unapproved change is not a governed change). version, evidence_ids and affected_node_ids are filled when they apply.",
  "type": "object",
  "properties": {
    "change_id": {
      "type": "string",
      "pattern": "^CHG-[0-9]{4}$"
    },
    "journey_id": {
      "type": "string",
      "pattern": "^(?:DOM(-[A-Z][A-Z0-9]*)+-[0-9]{3}|LFC-[A-Z]{2,6}(-[A-Z][A-Z0-9]*)+-[0-9]{3}|JRN-[A-Z]{2,6}(-[A-Z][A-Z0-9]*)+-[0-9]{3})$"
    },
    "changed_at": {
      "type": "string",
      "description": "ISO 8601 date (YYYY-MM-DD).",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "version": {
      "type": "string"
    },
    "change": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "string",
      "description": "Evidence IDs (EVD), ';'-separated.",
      "pattern": "^EVD-[0-9]{4}-[0-9]{4}(?:;EVD-[0-9]{4}-[0-9]{4})*$"
    },
    "affected_node_ids": {
      "type": "string",
      "description": "Node IDs (NOD), ';'-separated.",
      "pattern": "^NOD-[A-Z]{2,6}(-[A-Z][A-Z0-9]*)+-[0-9]{3}(-[0-9]{2})+(?:;NOD-[A-Z]{2,6}(-[A-Z][A-Z0-9]*)+-[0-9]{3}(-[0-9]{2})+)*$"
    },
    "approved_by": {
      "type": "string"
    }
  },
  "required": [
    "change_id",
    "journey_id",
    "changed_at",
    "change",
    "reason",
    "approved_by"
  ],
  "additionalProperties": false
}
